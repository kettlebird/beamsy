diff --git a/lib/raop_handlers.h b/lib/raop_handlers.h
index 168bb3f..7a583f0 100644
--- a/lib/raop_handlers.h
+++ b/lib/raop_handlers.h
@@ -358,7 +358,8 @@ raop_handler_pairsetup_pin(raop_conn_t *conn,
